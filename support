
{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ===== Kaggle notebook: paste into one cell (Settings -> Accelerator: GPU T4 x2 or P100) =====\n# Add your CSV via \"+ Add Input\" -> Upload, then run. Predicts Addicted_Score (regression).\nimport glob, time, warnings\nimport numpy as np, pandas as pd\nwarnings.filterwarnings(\"ignore\")\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.ensemble import AdaBoostRegressor, GradientBoostingRegressor, RandomForestRegressor\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.linear_model import Ridge\nfrom sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\nfrom sklearn.model_selection import GridSearchCV, train_test_split\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.svm import SVR\nfrom sklearn.tree import DecisionTreeRegressor\ntry:\n    import torch, torch.nn as nn\n    HAS_TORCH = True\nexcept ImportError:\n    HAS_TORCH = False\n\nSEED, TARGET = 42, \"Addicted_Score\"\n\n# ---- 1. Load data (finds the CSV anywhere under /kaggle/input, else current folder) ----\nimport os\nroots = [\"/kaggle/input\", \".\"]\npaths = [os.path.join(d, f) for r in roots if os.path.exists(r)\n         for d, _, fs in os.walk(r) for f in fs if f.lower().endswith(\".csv\")]\nprint(\"CSV files found:\", paths)\n# pick whichever CSV actually contains the target column (name-independent)\npath = next((p for p in paths if TARGET in open(p, errors=\"ignore\").readline()), None)\nassert path, \"No CSV with an Addicted_Score column found. Is the dataset added under Input (right sidebar)?\"\nprint(\"Using:\", path)\ndf = pd.read_csv(path)\ndf.columns = df.columns.str.strip()                       # headers have stray spaces\nfor c in df.select_dtypes(exclude=np.number).columns:     # values have trailing spaces\n    df[c] = df[c].astype(str).str.strip()\ndf = df.drop(columns=[\"Student_ID\"]).dropna(subset=[TARGET])\nprint(df.shape); print(df.head(3))\n\n# ---- 2. Models ----\ndef classical():\n    return {\n        \"Decision Tree\": (DecisionTreeRegressor(random_state=SEED), {\n            \"max_depth\": [None, 5, 10, 20], \"min_samples_leaf\": [1, 2, 4],\n            \"min_samples_split\": [2, 5], \"splitter\": [\"best\", \"random\"]}),\n        \"SVR\": (SVR(), {\"C\": [1, 10, 100], \"gamma\": [0.001, 0.01, 0.1], \"epsilon\": [0.01, 0.1]}),\n        \"Ridge\": (Ridge(random_state=SEED), {\"alpha\": [0.01, 0.1, 1, 10]}),\n        \"Random Forest\": (RandomForestRegressor(random_state=SEED, n_jobs=-1), {\n            \"n_estimators\": [100, 200], \"max_depth\": [None, 10, 20],\n            \"max_features\": [\"sqrt\", 1.0], \"min_samples_leaf\": [1, 2]}),\n        \"Gradient Boosting\": (GradientBoostingRegressor(random_state=SEED), {\n            \"n_estimators\": [100, 200], \"learning_rate\": [0.05, 0.1],\n            \"max_depth\": [3, 5], \"min_samples_leaf\": [1, 2]}),\n        \"AdaBoost\": (AdaBoostRegressor(random_state=SEED), {\n            \"n_estimators\": [100, 200], \"learning_rate\": [0.01, 0.1, 1.0],\n            \"loss\": [\"linear\", \"square\", \"exponential\"]}),\n    }\n\nif HAS_TORCH:\n    DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n    class FTTransformer(nn.Module):\n        def __init__(s, nf, d=64, heads=4, layers=2, drop=0.1):\n            super().__init__()\n            s.w = nn.Parameter(torch.randn(nf, d) * 0.02); s.b = nn.Parameter(torch.zeros(nf, d))\n            s.cls = nn.Parameter(torch.zeros(1, 1, d))\n            s.enc = nn.TransformerEncoder(nn.TransformerEncoderLayer(\n                d, heads, 2 * d, drop, batch_first=True, norm_first=True), layers)\n            s.head = nn.Sequential(nn.LayerNorm(d), nn.Linear(d, 1))\n        def forward(s, x):\n            t = x.unsqueeze(-1) * s.w + s.b\n            t = torch.cat([s.cls.expand(len(x), -1, -1), t], 1)\n            return s.head(s.enc(t)[:, 0]).squeeze(-1)\n\n    def train_nn(Xtr, ytr, Xte, epochs=100, patience=15, bs=32):\n        torch.manual_seed(SEED)\n        Xa, Xv, ya, yv = train_test_split(Xtr, ytr, test_size=0.15, random_state=SEED)\n        mu, sd = ya.mean(), ya.std() + 1e-8\n        T = lambda a: torch.tensor(np.asarray(a), dtype=torch.float32, device=DEVICE)\n        Xa, Xv, Xt, ya, yv = T(Xa), T(Xv), T(Xte), T((ya - mu) / sd), T((yv - mu) / sd)\n        m = FTTransformer(Xa.shape[1]).to(DEVICE)\n        opt = torch.optim.AdamW(m.parameters(), lr=1e-3, weight_decay=1e-4)\n        best, state, bad = 1e9, None, 0\n        for ep in range(epochs):\n            m.train(); perm = torch.randperm(len(Xa), device=DEVICE)\n            for i in range(0, len(perm), bs):\n                idx = perm[i:i + bs]; opt.zero_grad()\n                nn.functional.mse_loss(m(Xa[idx]), ya[idx]).backward(); opt.step()\n            m.eval()\n            with torch.no_grad(): v = nn.functional.mse_loss(m(Xv), yv).item()\n            if v < best - 1e-5: best, bad, state = v, 0, {k: x.clone() for k, x in m.state_dict().items()}\n            else:\n                bad += 1\n                if bad >= patience: break\n        m.load_state_dict(state); m.eval()\n        with torch.no_grad(): return m(Xt).cpu().numpy() * sd + mu, ep + 1\n\n# ---- 3. Experiment runner ----\ndef run(name, data):\n    print(f\"\\n{'='*20} {name} {'='*20}\")\n    X, y = data.drop(columns=[TARGET]), data[TARGET].astype(float).values\n    Xtr_r, Xte_r, ytr, yte = train_test_split(X, y, test_size=0.30, random_state=SEED)\n    num = X.select_dtypes(include=np.number).columns.tolist()\n    cat = [c for c in X.columns if c not in num]\n    pre = ColumnTransformer([\n        (\"n\", Pipeline([(\"i\", SimpleImputer(strategy=\"median\")), (\"s\", StandardScaler())]), num),\n        (\"c\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat)]).fit(Xtr_r)  # fit on train only\n    Xtr, Xte = pre.transform(Xtr_r), pre.transform(Xte_r)\n    print(f\"train={len(Xtr)} test={len(Xte)} features={Xtr.shape[1]}\")\n    score = lambda p: dict(R2=r2_score(yte, p), MAE=mean_absolute_error(yte, p), MSE=mean_squared_error(yte, p))\n    rows = []\n    for n, (est, grid) in classical().items():\n        t0 = time.time()\n        rows.append(dict(Model=n, Config=\"Base\", **score(est.fit(Xtr, ytr).predict(Xte))))\n        gs = GridSearchCV(est, grid, cv=5, scoring=\"r2\", n_jobs=-1).fit(Xtr, ytr)\n        rows.append(dict(Model=n, Config=\"Tuned\", CV_R2=gs.best_score_, **score(gs.predict(Xte))))\n        print(f\"{n:18s} CV R2={gs.best_score_:.4f}  best={gs.best_params_}  ({time.time()-t0:.0f}s)\")\n    if HAS_TORCH:\n        p, ep = train_nn(Xtr, ytr, Xte)\n        rows.append(dict(Model=f\"FT-Transformer ({ep} ep, {DEVICE})\", Config=\"Default\", **score(p)))\n    res = pd.DataFrame(rows); print(res.round(4).to_string(index=False))\n    res.to_csv(f\"results_{name}.csv\", index=False)\n    return res\n\nrun(\"all_features\", df)","metadata":{"_uuid":"c512df20-43bc-49c5-89a9-c1040f57cda4","_cell_guid":"87e5e9b8-9561-4f3f-9bbc-53518b2485f2","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-10-22T08:12:18.614716Z","iopub.execute_input":"2026-10-22T08:12:18.615110Z","iopub.status.idle":"2026-10-22T08:12:54.972494Z","shell.execute_reply.started":"2026-10-22T08:12:18.615086Z","shell.execute_reply":"2026-10-22T08:12:54.971785Z"}},"outputs":[{"name":"stdout","text":"CSV files found: ['/kaggle/input/datasets/aryansami6/social-media-addiction/Students-Social-Media-Addiction-1.csv', './results_all_features.csv', './results_behaviour_only.csv']\nUsing: /kaggle/input/datasets/aryansami6/social-med